# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real tokens.

# Foundry instance hostname (no https://)
FOUNDRY_HOSTNAME=your-instance.palantirfoundry.com

# A Foundry user or service account token with read access to the ontology
FOUNDRY_TOKEN=your_token_here

# RID of the ontology to export
# Find it in Ontology Manager → Settings, or via:
#   uv run python -c "
#   from foundry_ontology_docs.export import build_client
#   for o in build_client().ontologies.Ontology.list().data:
#       print(o.rid, o.display_name)
#   "
FOUNDRY_ONTOLOGY_RID=ri.ontology.main.ontology.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: path for the raw export JSON (default: out/ontology_export.json)
# FOUNDRY_EXPORT_PATH=out/ontology_export.json

# Optional: path to a custom domain-group mapping JSON (default: built-in groups.json)
# FOUNDRY_GROUPS_CONFIG=groups.json
